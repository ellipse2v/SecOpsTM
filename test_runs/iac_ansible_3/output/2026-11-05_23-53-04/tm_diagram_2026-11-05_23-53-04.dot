digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "External User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External User</TD></TR></TABLE>>, id="External_User"];
    
    
    
  }
  
  
    
  subgraph cluster_dmz {
    label="DMZ";
    "__hidden_node_dmz" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "WebServer_1" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">WebServer_1</TD></TR></TABLE>>, id="WebServer_1"];
    
    
  }
  
  
    
  subgraph cluster_internal_network {
    label="Internal Network";
    "__hidden_node_internal_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "AppServer_1" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">AppServer_1</TD></TR></TABLE>>, id="AppServer_1"];
    
    "DBServer_1" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">DBServer_1</TD></TR></TABLE>>, id="DBServer_1"];
    
    
  }
  
  

  

  

  
  "External User" -> "WebServer_1" [label="", label=<User to WebServer<BR/>Protocol: HTTPS<BR/>Data: Web Traffic>, id="edge_External_User_WebServer_1", fontsize=7, class="protocol-HTTPS"];
  
  "WebServer_1" -> "AppServer_1" [label="", label=<WebServer to AppServer<BR/>Protocol: HTTP/S<BR/>Data: Application Requests>, id="edge_WebServer_1_AppServer_1", fontsize=7, class="protocol-HTTP_S"];
  
  "AppServer_1" -> "DBServer_1" [label="", label=<AppServer to DBServer<BR/>Protocol: DB<BR/>Data: Database Queries>, id="edge_AppServer_1_DBServer_1", fontsize=7, class="protocol-DB"];
  

  
}