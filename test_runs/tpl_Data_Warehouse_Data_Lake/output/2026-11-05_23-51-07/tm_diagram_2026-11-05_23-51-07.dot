digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_data_sources {
    label="Data Sources";
    "__hidden_node_data_sources" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="red";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Data Provider" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Data Provider</TD></TR></TABLE>>, id="Data_Provider"];
    
    
    
  }
  
  
    
  subgraph cluster_ingestion_layer {
    label="Ingestion Layer";
    "__hidden_node_ingestion_layer" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="orange";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Data Engineer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Data Engineer</TD></TR></TABLE>>, id="Data_Engineer"];
    
    
    "ETLPipeline" [shape=box, style=filled, fillcolor="lightblue", label="ETLPipeline", id="ETLPipeline"];
    
    
  }
  
  
    
  subgraph cluster_storage_layer__raw_curated_ {
    label="Storage Layer (Raw/Curated)";
    "__hidden_node_storage_layer__raw_curated_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightblue";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "ObjectStorage" [shape=box, style=filled, fillcolor="lightblue", label="ObjectStorage", id="ObjectStorage"];
    
    "DataLakehouse" [shape=box, style=filled, fillcolor="lightblue", label="DataLakehouse", id="DataLakehouse"];
    
    
  }
  
  
    
  subgraph cluster_processing_layer {
    label="Processing Layer";
    "__hidden_node_processing_layer" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="green";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "SparkCluster" [shape=box, style=filled, fillcolor="lightblue", label="SparkCluster", id="SparkCluster"];
    
    "DataWarehouse" [shape=box, style=filled, fillcolor="lightblue", label="DataWarehouse", id="DataWarehouse"];
    
    
  }
  
  
    
  subgraph cluster_consumption_layer {
    label="Consumption Layer";
    "__hidden_node_consumption_layer" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="purple";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Data Analyst" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Data Analyst</TD></TR></TABLE>>, id="Data_Analyst"];
    
    "Business User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Business User</TD></TR></TABLE>>, id="Business_User"];
    
    
    "BITools" [shape=box, style=filled, fillcolor="lightblue", label="BITools", id="BITools"];
    
    
  }
  
  

  

  

  
  "Data Provider" -> "ETLPipeline" [label="", color="blue", style="dashed", label=<Data Ingestion<BR/>Protocol: Various (API, SFTP, Streaming)>, id="edge_Data_Provider_ETLPipeline", fontsize=7, class="protocol-Various__API__SFTP__Streaming_"];
  
  "ETLPipeline" -> "ObjectStorage" [label="", color="gray", style="dashed", label=<Load to Raw Storage<BR/>Protocol: Internal API>, id="edge_ETLPipeline_ObjectStorage", fontsize=7, class="protocol-Internal_API"];
  
  "ObjectStorage" -> "SparkCluster" [label="", color="gray", style="dashed", label=<Data Transformation<BR/>Protocol: Internal API>, id="edge_ObjectStorage_SparkCluster", fontsize=7, class="protocol-Internal_API"];
  
  "SparkCluster" -> "DataLakehouse" [label="", color="gray", style="dashed", label=<Load to Curated<BR/>Protocol: Internal API>, id="edge_SparkCluster_DataLakehouse", fontsize=7, class="protocol-Internal_API"];
  
  "BITools" -> "DataWarehouse" [label="", color="purple", style="dashed", label=<Query Data<BR/>Protocol: JDBC/ODBC>, id="edge_BITools_DataWarehouse", fontsize=7, class="protocol-JDBC_ODBC"];
  
  "Data Analyst" -> "ObjectStorage" [label="", color="darkgreen", style="solid", label=<Access Raw Data<BR/>Protocol: API>, id="edge_Data_Analyst_ObjectStorage", fontsize=7, class="protocol-API"];
  
  "Business User" -> "DataLakehouse" [label="", color="darkgreen", style="solid", label=<Access Curated Data<BR/>Protocol: API>, id="edge_Business_User_DataLakehouse", fontsize=7, class="protocol-API"];
  

  
}