digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_public_frontend_zone {
    label="Public Frontend Zone";
    "__hidden_node_public_frontend_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightsalmon";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "LoadBalancer" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>LoadBalancer</TD></TR></TABLE>>, id="LoadBalancer"];
    
    "WebServer" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD></TR><TR><TD>WebServer</TD></TR></TABLE>>, id="WebServer"];
    
    
  }
  
  

  

  

  
  "LoadBalancer" -> "WebServer" [label="", color="orange", style="dashed", label=<LBToWebServer<BR/>Protocol: HTTP>, id="edge_LoadBalancer_WebServer", fontsize=7, class="protocol-HTTP"];
  
  "WebServer" -> "LoadBalancer" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<WebServerLoop<BR/>Protocol: HTTPS>, id="edge_WebServer_LoadBalancer", fontsize=7, class="protocol-HTTPS"];
  

  
  
  
  
  subgraph cluster__external_parent_in {
    label="External connections in (parent model)";
    style="dashed,filled";
    fillcolor="#e8f5e9";
    color="#66bb6a";
    penwidth=1;
    fontsize=9;
    fontcolor="#2e7d32";
    
    
    
    
    "__ghost_Customer" [label="Customer", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
  }
  
  "__ghost_Customer" -> "LoadBalancer" [style=dashed, color="#66bb6a", label="HTTPS", fontsize=7, arrowsize=0.7];
  
  
  
  subgraph cluster__external_parent_out {
    label="External connections out (parent model)";
    style="dashed,filled";
    fillcolor="#fff3e0";
    color="#ffa726";
    penwidth=1;
    fontsize=9;
    fontcolor="#e65100";
    
    
    
    
    "__ghost_DMZTier" [label="DMZTier", shape=ellipse, style="dashed,filled", fillcolor="#ffe0b2", color="#ffa726", fontcolor="#bf360c", fontsize=9];
    
    
  }
  
  "LoadBalancer" -> "__ghost_DMZTier" [style=dashed, color="#ffa726", label="HTTPS", fontsize=7, arrowsize=0.7];
  
  
  
}