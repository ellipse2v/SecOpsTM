digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_gateway_internal_zone {
    label="Gateway Internal Zone";
    "__hidden_node_gateway_internal_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightyellow";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "LoadBalancer" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>LoadBalancer</TD></TR></TABLE>>, id="LoadBalancer"];
    
    "GatewayInstance_1" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD></TR><TR><TD>GatewayInstance_1</TD></TR></TABLE>>, id="GatewayInstance_1"];
    
    "GatewayInstance_2" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD></TR><TR><TD>GatewayInstance_2</TD></TR></TABLE>>, id="GatewayInstance_2"];
    
    
  }
  
  

  

  

  
  "LoadBalancer" -> "GatewayInstance_1" [label="", color="orange", style="dashed", label=<LBToInstance1<BR/>Protocol: HTTP<BR/>Data: RoutedRequest>, id="edge_LoadBalancer_GatewayInstance_1", fontsize=7, class="protocol-HTTP"];
  
  "LoadBalancer" -> "GatewayInstance_2" [label="", color="orange", style="dashed", label=<LBToInstance2<BR/>Protocol: HTTP<BR/>Data: RoutedRequest>, id="edge_LoadBalancer_GatewayInstance_2", fontsize=7, class="protocol-HTTP"];
  

  
  
  
  
  subgraph cluster__external_parent_in {
    label="External connections in (parent model)";
    style="dashed,filled";
    fillcolor="#e8f5e9";
    color="#66bb6a";
    penwidth=1;
    fontsize=9;
    fontcolor="#2e7d32";
    
    
    
    
    "__ghost_Firewall_1" [label="Firewall_1", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
    
    
    "__ghost_Firewall_2" [label="Firewall_2", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
  }
  
  "__ghost_Firewall_1" -> "LoadBalancer" [style=dashed, color="#66bb6a", label="HTTPS", fontsize=7, arrowsize=0.7];
  
  "__ghost_Firewall_2" -> "LoadBalancer" [style=dashed, color="#66bb6a", label="HTTPS", fontsize=7, arrowsize=0.7];
  
  
  
  
}