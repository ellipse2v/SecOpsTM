digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_protected_db_zone {
    label="Protected DB Zone";
    "__hidden_node_protected_db_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lavender";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "PrimaryDB" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>PrimaryDB</TD></TR></TABLE>>, id="PrimaryDB"];
    
    "ReplicaDB" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>ReplicaDB</TD></TR></TABLE>>, id="ReplicaDB"];
    
    
  }
  
  

  

  

  
  "PrimaryDB" -> "ReplicaDB" [label="", color="purple", style="solid", label=<PrimaryToReplica<BR/>Protocol: PostgreSQL-Replication<BR/>Data: ReplicationStream>, id="edge_PrimaryDB_ReplicaDB", fontsize=7, class="protocol-PostgreSQL_Replication"];
  

  
  
  
  
  subgraph cluster__external_parent_in {
    label="External connections in (parent model)";
    style="dashed,filled";
    fillcolor="#e8f5e9";
    color="#66bb6a";
    penwidth=1;
    fontsize=9;
    fontcolor="#2e7d32";
    
    
    
    
    "__ghost_BackendServices" [label="BackendServices", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
  }
  
  "__ghost_BackendServices" -> "PrimaryDB" [style=dashed, color="#66bb6a", label="PostgreSQL", fontsize=7, arrowsize=0.7];
  
  
  
  
}