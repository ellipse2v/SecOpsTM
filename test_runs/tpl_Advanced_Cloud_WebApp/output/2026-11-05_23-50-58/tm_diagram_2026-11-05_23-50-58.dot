digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_public_cloud_zone {
    label="Public Cloud Zone";
    "__hidden_node_public_cloud_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "End User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>End User</TD></TR></TABLE>>, id="End_User"];
    
    "DevOps Engineer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>DevOps Engineer</TD></TR></TABLE>>, id="DevOps_Engineer"];
    
    
    "CDN Load Balancer" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>CDN Load Balancer</TD></TR></TABLE>>, id="CDN_Load_Balancer"];
    
    "API Gateway" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD></TR><TR><TD>API Gateway</TD></TR></TABLE>>, id="API_Gateway"];
    
    
  }
  
  
    
  subgraph cluster_private_app_zone {
    label="Private App Zone";
    "__hidden_node_private_app_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Auth Service" [shape=box, style=filled, fillcolor="lightblue", label="Auth Service", id="Auth_Service"];
    
    "Product Microservice" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Product Microservice</TD></TR></TABLE>>, id="Product_Microservice"];
    
    "CI/CD Server" [shape=box, style=filled, fillcolor="lightblue", label="CI/CD Server", id="CI_CD_Server"];
    
    
  }
  
  
    
  subgraph cluster_secure_data_zone {
    label="Secure Data Zone";
    "__hidden_node_secure_data_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Product Database" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>Product Database</TD></TR></TABLE>>, id="Product_Database"];
    
    
  }
  
  

  

  

  
  "End User" -> "API Gateway" [label="", color="darkgreen", style="solid", label=<UserToGateway<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_End_User_API_Gateway", fontsize=7, class="protocol-HTTPS"];
  
  "API Gateway" -> "Auth Service" [label="", color="darkgreen", style="solid", label=<GatewayToAuth<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_API_Gateway_Auth_Service", fontsize=7, class="protocol-HTTPS"];
  
  "API Gateway" -> "Product Microservice" [label="", color="darkgreen", style="solid", label=<GatewayToProductSvc<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_API_Gateway_Product_Microservice", fontsize=7, class="protocol-HTTPS"];
  
  "Product Microservice" -> "Product Database" [label="", color="red", style="dashed", label=<ProductSvcToDB<BR/>Protocol: TCP>, id="edge_Product_Microservice_Product_Database", fontsize=7, class="protocol-TCP"];
  
  "DevOps Engineer" -> "CI/CD Server" [label="", color="blue", style="dashed", label=<DevOpsToCICD<BR/>Protocol: SSH<BR/>🔒 Encrypted>, id="edge_DevOps_Engineer_CI_CD_Server", fontsize=7, class="protocol-SSH"];
  
  "CI/CD Server" -> "Product Microservice" [label="", color="blue", style="dashed", label=<CICDToProductSvc<BR/>Protocol: SSH<BR/>🔒 Encrypted>, id="edge_CI_CD_Server_Product_Microservice", fontsize=7, class="protocol-SSH"];
  

  
}