digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_space_segment {
    label="Space Segment";
    "__hidden_node_space_segment" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "OBC" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/onboard-computer.svg" SCALE="TRUE"/></TD></TR><TR><TD>OBC</TD></TR></TABLE>>, id="OBC"];
    
    "GPS-Receiver" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/onboard-computer.svg" SCALE="TRUE"/></TD></TR><TR><TD>GPS-Receiver</TD></TR></TABLE>>, id="GPS_Receiver"];
    
    "ADCS" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/onboard-computer.svg" SCALE="TRUE"/></TD></TR><TR><TD>ADCS</TD></TR></TABLE>>, id="ADCS"];
    
    "Mission-Payload" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/leo-satellite.svg" SCALE="TRUE"/></TD></TR><TR><TD>Mission-Payload</TD></TR></TABLE>>, id="Mission_Payload"];
    
    
  }
  
  
    
  subgraph cluster_ground_segment {
    label="Ground Segment";
    "__hidden_node_ground_segment" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Cyber Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cyber Attacker</TD></TR></TABLE>>, id="Cyber_Attacker"];
    
    
    "Ground-Station" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ground-station.svg" SCALE="TRUE"/></TD></TR><TR><TD>Ground-Station</TD></TR></TABLE>>, id="Ground_Station"];
    
    
  }
  
  
    
  subgraph cluster_tt_c_channel {
    label="TT&amp;C Channel";
    "__hidden_node_tt_c_channel" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "RF Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>RF Attacker</TD></TR></TABLE>>, id="RF_Attacker"];
    
    
    "TTC-Frontend" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ttc-link.svg" SCALE="TRUE"/></TD></TR><TR><TD>TTC-Frontend</TD></TR></TABLE>>, id="TTC_Frontend"];
    
    "TLM-Receiver" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ttc-link.svg" SCALE="TRUE"/></TD></TR><TR><TD>TLM-Receiver</TD></TR></TABLE>>, id="TLM_Receiver"];
    
    
  }
  
  
    
  subgraph cluster_mission_network {
    label="Mission Network";
    "__hidden_node_mission_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Mission Operator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Mission Operator</TD></TR></TABLE>>, id="Mission_Operator"];
    
    
    "Mission-Control-Server" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Mission-Control-Server</TD></TR></TABLE>>, id="Mission_Control_Server"];
    
    
  }
  
  
    
  subgraph cluster_integration_network {
    label="Integration Network";
    "__hidden_node_integration_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Supply Chain Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Supply Chain Attacker</TD></TR></TABLE>>, id="Supply_Chain_Attacker"];
    
    
    "EGSE" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">EGSE</TD></TR></TABLE>>, id="EGSE"];
    
    
  }
  
  

  

  

  
  "Mission Operator" -> "Ground-Station" [label="", color="darkgreen", style="solid", label=<Operator-to-GS<BR/>Protocol: HTTPS>, id="edge_Mission_Operator_Ground_Station", fontsize=7, class="protocol-HTTPS"];
  
  "Ground-Station" -> "TTC-Frontend" [label="", color="slateblue", style="dashed", label=<GS-to-TTC<BR/>Protocol: SLE>, id="edge_Ground_Station_TTC_Frontend", fontsize=7, class="protocol-SLE"];
  
  "TTC-Frontend" -> "OBC" [label="", color="purple", style="dashed", label=<RF-Uplink<BR/>Protocol: CCSDS>, id="edge_TTC_Frontend_OBC", fontsize=7, class="protocol-CCSDS"];
  
  "OBC" -> "TLM-Receiver" [label="", color="purple", style="dashed", label=<RF-Downlink<BR/>Protocol: CCSDS>, id="edge_OBC_TLM_Receiver", fontsize=7, class="protocol-CCSDS"];
  
  "TLM-Receiver" -> "Ground-Station" [label="", color="slateblue", style="dashed", label=<TLM-to-GS<BR/>Protocol: SLE>, id="edge_TLM_Receiver_Ground_Station", fontsize=7, class="protocol-SLE"];
  
  "GPS-Receiver" -> "ADCS" [label="", color="gold", style="dashed", label=<GPS-Signal<BR/>Protocol: NMEA>, id="edge_GPS_Receiver_ADCS", fontsize=7, class="protocol-NMEA"];
  
  "OBC" -> "ADCS" [label="", color="darkviolet", style="dashed", label=<OBC-to-ADCS<BR/>Protocol: MIL-STD-1553>, id="edge_OBC_ADCS", fontsize=7, class="protocol-MIL_STD_1553"];
  
  "OBC" -> "Mission-Payload" [label="", color="darkorchid", style="dashed", label=<OBC-to-Payload<BR/>Protocol: SpaceWire>, id="edge_OBC_Mission_Payload", fontsize=7, class="protocol-SpaceWire"];
  
  "RF Attacker" -> "TTC-Frontend" [label="", color="crimson", style="dotted", label=<Attacker-RF-Uplink<BR/>Protocol: RF>, id="edge_RF_Attacker_TTC_Frontend", fontsize=7, class="protocol-RF"];
  
  "RF Attacker" -> "TLM-Receiver" [label="", color="crimson", style="dotted", label=<Attacker-RF-Downlink<BR/>Protocol: RF>, id="edge_RF_Attacker_TLM_Receiver", fontsize=7, class="protocol-RF"];
  
  "RF Attacker" -> "GPS-Receiver" [label="", color="goldenrod", style="dotted", label=<Attacker-GNSS-Spoof<BR/>Protocol: GNSS>, id="edge_RF_Attacker_GPS_Receiver", fontsize=7, class="protocol-GNSS"];
  
  "Cyber Attacker" -> "Ground-Station" [label="", color="darkgreen", style="solid", label=<Attacker-GS-Exploit<BR/>Protocol: HTTPS>, id="edge_Cyber_Attacker_Ground_Station", fontsize=7, class="protocol-HTTPS"];
  
  "Ground-Station" -> "Mission-Control-Server" [label="", color="darkgreen", style="solid", label=<GS-to-MCS<BR/>Protocol: HTTPS>, id="edge_Ground_Station_Mission_Control_Server", fontsize=7, class="protocol-HTTPS"];
  
  "Supply Chain Attacker" -> "EGSE" [label="", color="darkorange", style="solid", label=<Supply-Chain-EGSE<BR/>Protocol: USB>, id="edge_Supply_Chain_Attacker_EGSE", fontsize=7, class="protocol-USB"];
  
  "EGSE" -> "OBC" [label="", color="chocolate", style="dashed", label=<EGSE-to-OBC<BR/>Protocol: JTAG>, id="edge_EGSE_OBC", fontsize=7, class="protocol-JTAG"];
  

  
}