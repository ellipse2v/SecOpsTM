  "External Attacker" -> "Edge Router" [label="", color="gray", label=<ExternalToRouter<BR/>Protocol: TCP>, id="edge_External_Attacker_Edge_Router", fontsize=7, class="protocol-TCP"];
  
  "Remote Employee" -> "Corporate VPN Gateway" [label="", color="darkblue", style="dashed", label=<RemoteToVPN<BR/>Protocol: IPSEC<BR/>🔒 Encrypted>, id="edge_Remote_Employee_Corporate_VPN_Gateway", fontsize=7, class="protocol-IPSEC"];
  
  "External Attacker" -> "Mail Gateway" [label="", color="gray", label=<ExternalToMail<BR/>Protocol: SMTP>, id="edge_External_Attacker_Mail_Gateway", fontsize=7, class="protocol-SMTP"];
  
  "Edge Router" -> "Web Application Firewall" [label="", color="red", style="solid", label=<RouterToWAF<BR/>Protocol: HTTP>, id="edge_Edge_Router_Web_Application_Firewall", fontsize=7, class="protocol-HTTP"];
  
  "Web Application Firewall" -> "Reverse Proxy" [label="", color="red", style="solid", label=<WAFToProxy<BR/>Protocol: HTTP>, id="edge_Web_Application_Firewall_Reverse_Proxy", fontsize=7, class="protocol-HTTP"];
  
  "Reverse Proxy" -> "Internal Firewall" [label="", color="red", style="solid", label=<ProxyToInternalFW<BR/>Protocol: HTTP>, id="edge_Reverse_Proxy_Internal_Firewall", fontsize=7, class="protocol-HTTP"];
  
  "Mail Gateway" -> "Employee Workstation" [label="", color="gray", label=<MailToWorkstation<BR/>Protocol: SMTP>, id="edge_Mail_Gateway_Employee_Workstation", fontsize=7, class="protocol-SMTP"];
  
  "Corporate VPN Gateway" -> "Internal Firewall" [label="", color="darkblue", style="dashed", label=<VPNToInternalFW<BR/>Protocol: IPSEC<BR/>🔒 Encrypted>, id="edge_Corporate_VPN_Gateway_Internal_Firewall", fontsize=7, class="protocol-IPSEC"];
  
  "Internal Firewall" -> "Employee Workstation" [label="", color="gray", label=<InternalFWToWorkstation<BR/>Protocol: TCP>, id="edge_Internal_Firewall_Employee_Workstation", fontsize=7, class="protocol-TCP"];
  
  "Corporate Employee" -> "Employee Workstation" [label="", color="steelblue", style="dashed", label=<EmployeeToWorkstation<BR/>Protocol: RDP>, id="edge_Corporate_Employee_Employee_Workstation", fontsize=7, class="protocol-RDP"];
  
  "Employee Workstation" -> "Primary Domain Controller" [label="", color="purple", style="solid", label=<WorkstationToAD<BR/>Protocol: LDAP>, id="edge_Employee_Workstation_Primary_Domain_Controller", fontsize=7, class="protocol-LDAP"];
  
  "Employee Workstation" -> "File Server" [label="", color="orange", label=<WorkstationToFile<BR/>Protocol: SMB>, id="edge_Employee_Workstation_File_Server", fontsize=7, class="protocol-SMB"];
  
  "Employee Workstation" -> "SIEM Server" [label="", color="gray", style="dotted", label=<WorkstationToSIEM<BR/>Protocol: SYSLOG>, id="edge_Employee_Workstation_SIEM_Server", fontsize=7, class="protocol-SYSLOG"];
  
  "Primary Domain Controller" -> "Backup Domain Controller" [label="", color="darkorange", label=<ADToBackupAD<BR/>Protocol: RPC>, id="edge_Primary_Domain_Controller_Backup_Domain_Controller", fontsize=7, class="protocol-RPC"];
  
  "Primary Domain Controller" -> "PKI Certificate Authority" [label="", color="darkorange", label=<ADToPKI<BR/>Protocol: RPC<BR/>🔒 Encrypted>, id="edge_Primary_Domain_Controller_PKI_Certificate_Authority", fontsize=7, class="protocol-RPC"];
  
  "SIEM Server" -> "Primary Domain Controller" [label="", color="purple", style="solid", label=<SIEMToAD<BR/>Protocol: LDAP>, id="edge_SIEM_Server_Primary_Domain_Controller", fontsize=7, class="protocol-LDAP"];
  
  "IT Administrator" -> "Jump Server" [label="", color="steelblue", style="dashed", label=<ITAdminToJump<BR/>Protocol: RDP<BR/>🔒 Encrypted>, id="edge_IT_Administrator_Jump_Server", fontsize=7, class="protocol-RDP"];
  
  "Jump Server" -> "Primary Domain Controller" [dir="both", label="
↔️ Bidirectional", color="steelblue", label=<JumpToAD<BR/>Protocol: WinRM<BR/>🔒 Encrypted>, id="edge_Jump_Server_Primary_Domain_Controller", fontsize=7, class="protocol-WinRM"];
  
  "Jump Server" -> "SCADA HMI" [label="", color="steelblue", style="dashed", label=<JumpToSCADA<BR/>Protocol: RDP>, id="edge_Jump_Server_SCADA_HMI", fontsize=7, class="protocol-RDP"];
  
  "Jump Server" -> "Financial ERP System" [label="", color="orange", label=<JumpToERP<BR/>Protocol: SAP>, id="edge_Jump_Server_Financial_ERP_System", fontsize=7, class="protocol-SAP"];
  
  "Finance Employee" -> "Financial ERP System" [label="", color="gray", label=<FinanceEmpToERP<BR/>Protocol: TCP>, id="edge_Finance_Employee_Financial_ERP_System", fontsize=7, class="protocol-TCP"];
  
  "Financial ERP System" -> "Core Database Cluster" [label="", color="purple", label=<ERPToCoreDB<BR/>Protocol: SQL>, id="edge_Financial_ERP_System_Core_Database_Cluster", fontsize=7, class="protocol-SQL"];
  
  "Developer" -> "Source Code Repository" [label="", color="blue", style="dashed", label=<DevToGitLab<BR/>Protocol: SSH<BR/>🔒 Encrypted>, id="edge_Developer_Source_Code_Repository", fontsize=7, class="protocol-SSH"];
  
  "Developer" -> "CI CD Pipeline" [label="", color="darkgreen", style="solid", label=<DevToCICD<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_Developer_CI_CD_Pipeline", fontsize=7, class="protocol-HTTPS"];
  
  "Source Code Repository" -> "CI CD Pipeline" [label="", color="darkgreen", style="solid", label=<GitLabToCICD<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_Source_Code_Repository_CI_CD_Pipeline", fontsize=7, class="protocol-HTTPS"];
  
  "CI CD Pipeline" -> "Core Database Cluster" [label="", color="purple", label=<CICDToCoreDB<BR/>Protocol: SQL>, id="edge_CI_CD_Pipeline_Core_Database_Cluster", fontsize=7, class="protocol-SQL"];
  
  "Core Database Cluster" -> "Backup Server" [label="", color="gray", label=<CoreDBToBackup<BR/>Protocol: TCP>, id="edge_Core_Database_Cluster_Backup_Server", fontsize=7, class="protocol-TCP"];
  
  "SCADA Operator" -> "SCADA HMI" [label="", color="steelblue", style="dashed", label=<SCADAOpToHMI<BR/>Protocol: RDP>, id="edge_SCADA_Operator_SCADA_HMI", fontsize=7, class="protocol-RDP"];
  
  "SCADA HMI" -> "PLC Controller" [label="", color="crimson", style="solid", label=<HMIToPLC<BR/>Protocol: Modbus>, id="edge_SCADA_HMI_PLC_Controller", fontsize=7, class="protocol-Modbus"];
  
  "Internal DNS Server" -> "Primary Domain Controller" [label="", color="teal", label=<InternalDNSToAD<BR/>Protocol: DNS>, id="edge_Internal_DNS_Server_Primary_Domain_Controller", fontsize=7, class="protocol-DNS"];
  

  
}