digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="red";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "External Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Attacker</TD></TR></TABLE>>, id="External_Attacker"];
    
    "Remote Employee" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Remote Employee</TD></TR></TABLE>>, id="Remote_Employee"];
    
    
    
  }
  
  
    
  subgraph cluster_dmz {
    label="DMZ";
    "__hidden_node_dmz" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Edge Router" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>Edge Router</TD></TR></TABLE>>, id="Edge_Router"];
    
    "Web Application Firewall" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>Web Application Firewall</TD></TR></TABLE>>, id="Web_Application_Firewall"];
    
    "Reverse Proxy" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD></TR><TR><TD>Reverse Proxy</TD></TR></TABLE>>, id="Reverse_Proxy"];
    
    "Mail Gateway" [shape=box, style=filled, fillcolor="lightblue", label="Mail Gateway", id="Mail_Gateway"];
    
    
  }
  
  
    
  subgraph cluster_vpn_perimeter {
    label="VPN Perimeter";
    "__hidden_node_vpn_perimeter" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orangered";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Corporate VPN Gateway" [shape=box, style=filled, fillcolor="lightblue", label="Corporate VPN Gateway", id="Corporate_VPN_Gateway"];
    
    
  }
  
  
    
  subgraph cluster_internal_network {
    label="Internal Network";
    "__hidden_node_internal_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgreen";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Corporate Employee" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Corporate Employee</TD></TR></TABLE>>, id="Corporate_Employee"];
    
    
    "Internal Firewall" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>Internal Firewall</TD></TR></TABLE>>, id="Internal_Firewall"];
    
    "Internal DNS Server" [shape=box, style=filled, fillcolor="lightblue", label="Internal DNS Server", id="Internal_DNS_Server"];
    
    "Employee Workstation" [shape=box, style=filled, fillcolor="lightblue", label="Employee Workstation", id="Employee_Workstation"];
    
    "File Server" [shape=box, style=filled, fillcolor="lightblue", label="File Server", id="File_Server"];
    
    
  }
  
  
    
  subgraph cluster_it_infrastructure_zone {
    label="IT Infrastructure Zone";
    "__hidden_node_it_infrastructure_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightblue";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "IT Administrator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>IT Administrator</TD></TR></TABLE>>, id="IT_Administrator"];
    
    
    "Primary Domain Controller" [shape=box, style=filled, fillcolor="lightblue", label="Primary Domain Controller", id="Primary_Domain_Controller"];
    
    "Backup Domain Controller" [shape=box, style=filled, fillcolor="lightblue", label="Backup Domain Controller", id="Backup_Domain_Controller"];
    
    "PKI Certificate Authority" [shape=box, style=filled, fillcolor="lightblue", label="PKI Certificate Authority", id="PKI_Certificate_Authority"];
    
    "SIEM Server" [shape=box, style=filled, fillcolor="lightblue", label="SIEM Server", id="SIEM_Server"];
    
    "Jump Server" [shape=box, style=filled, fillcolor="lightblue", label="Jump Server", id="Jump_Server"];
    
    
  }
  
  
    
  subgraph cluster_finance_zone {
    label="Finance Zone";
    "__hidden_node_finance_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightyellow";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Finance Employee" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Finance Employee</TD></TR></TABLE>>, id="Finance_Employee"];
    
    
    "Financial ERP System" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>Financial ERP System</TD></TR></TABLE>>, id="Financial_ERP_System"];
    
    "Finance Workstation" [shape=box, style=filled, fillcolor="lightblue", label="Finance Workstation", id="Finance_Workstation"];
    
    
  }
  
  
    
  subgraph cluster_development_zone {
    label="Development Zone";
    "__hidden_node_development_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightcyan";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Developer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Developer</TD></TR></TABLE>>, id="Developer"];
    
    
    "Source Code Repository" [shape=box, style=filled, fillcolor="lightblue", label="Source Code Repository", id="Source_Code_Repository"];
    
    "CI CD Pipeline" [shape=box, style=filled, fillcolor="lightblue", label="CI CD Pipeline", id="CI_CD_Pipeline"];
    
    
  }
  
  
    
  subgraph cluster_restricted_data_zone {
    label="Restricted Data Zone";
    "__hidden_node_restricted_data_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lavender";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Core Database Cluster" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>Core Database Cluster</TD></TR></TABLE>>, id="Core_Database_Cluster"];
    
    "Backup Server" [shape=box, style=filled, fillcolor="lightblue", label="Backup Server", id="Backup_Server"];
    
    
  }
  
  
    
  subgraph cluster_ot_scada_zone {
    label="OT SCADA Zone";
    "__hidden_node_ot_scada_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="mistyrose";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "SCADA Operator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>SCADA Operator</TD></TR></TABLE>>, id="SCADA_Operator"];
    
    
    "SCADA HMI" [shape=box, style=filled, fillcolor="lightblue", label="SCADA HMI", id="SCADA_HMI"];
    
    "PLC Controller" [shape=box, style=filled, fillcolor="lightblue", label="PLC Controller", id="PLC_Controller"];
    
    
