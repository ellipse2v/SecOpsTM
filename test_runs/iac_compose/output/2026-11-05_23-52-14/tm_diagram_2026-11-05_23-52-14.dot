digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_compose_default {
    label="compose_default";
    "__hidden_node_compose_default" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "web" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD></TR><TR><TD>web</TD></TR></TABLE>>, id="web"];
    
    "app" [shape=box, style=filled, fillcolor="lightblue", label="app", id="app"];
    
    "db" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>db</TD></TR></TABLE>>, id="db"];
    
    "cache" [shape=box, style=filled, fillcolor="lightblue", label="cache", id="cache"];
    
    
  }
  
  

  

  

  
  "web" -> "app" [label="", label=<web_to_app<BR/>Protocol: TCP>, id="edge_web_app", fontsize=7, class="protocol-TCP"];
  
  "app" -> "db" [label="", label=<app_to_db<BR/>Protocol: PostgreSQL>, id="edge_app_db", fontsize=7, class="protocol-PostgreSQL"];
  
  "app" -> "cache" [label="", label=<app_to_cache<BR/>Protocol: Redis>, id="edge_app_cache", fontsize=7, class="protocol-Redis"];
  

  
}