digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_mobile_device__client_ {
    label="Mobile Device (Client)";
    "__hidden_node_mobile_device__client_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightblue";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Mobile User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Mobile User</TD></TR></TABLE>>, id="Mobile_User"];
    
    
    "Mobile Application" [shape=box, style=filled, fillcolor="lightblue", label="Mobile Application", id="Mobile_Application"];
    
    
  }
  
  
    
  subgraph cluster_backend_api {
    label="Backend API";
    "__hidden_node_backend_api" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="green";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "APIGateway" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">APIGateway</TD></TR></TABLE>>, id="APIGateway"];
    
    "BackendServer" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">BackendServer</TD></TR></TABLE>>, id="BackendServer"];
    
    "BackendDatabase" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>BackendDatabase</TD></TR></TABLE>>, id="BackendDatabase"];
    
    
  }
  
  
    
  subgraph cluster_third_party_services__authentication__payment_ {
    label="Third-Party Services (Authentication, Payment)";
    "__hidden_node_third_party_services__authentication__payment_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "IdentityProvider" [shape=box, style=filled, fillcolor="lightblue", label="IdentityProvider", id="IdentityProvider"];
    
    "Payment Gateway" [shape=box, style=filled, fillcolor="lightblue", label="Payment Gateway", id="Payment_Gateway"];
    
    
  }
  
  

  

  

  
  "Mobile Application" -> "IdentityProvider" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<Auth Request<BR/>Protocol: HTTPS>, id="edge_Mobile_Application_IdentityProvider", fontsize=7, class="protocol-HTTPS"];
  
  "Mobile Application" -> "APIGateway" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<API Data Request<BR/>Protocol: HTTPS>, id="edge_Mobile_Application_APIGateway", fontsize=7, class="protocol-HTTPS"];
  
  "APIGateway" -> "BackendServer" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<Backend Request<BR/>Protocol: HTTPS>, id="edge_APIGateway_BackendServer", fontsize=7, class="protocol-HTTPS"];
  
  "BackendServer" -> "BackendDatabase" [dir="both", label="
↔️ Bidirectional", color="purple", style="dashed", label=<DB Request<BR/>Protocol: JDBC/ODBC>, id="edge_BackendServer_BackendDatabase", fontsize=7, class="protocol-JDBC_ODBC"];
  
  "Mobile Application" -> "Payment Gateway" [label="", color="darkgreen", style="solid", label=<Payment Request<BR/>Protocol: HTTPS>, id="edge_Mobile_Application_Payment_Gateway", fontsize=7, class="protocol-HTTPS"];
  

  
}