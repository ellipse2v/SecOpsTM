digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_development_environment {
    label="Development Environment";
    "__hidden_node_development_environment" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightblue";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Developer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Developer</TD></TR></TABLE>>, id="Developer"];
    
    
    
  }
  
  
    
  subgraph cluster_code_repository {
    label="Code Repository";
    "__hidden_node_code_repository" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="gray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Git Repository" [shape=box, style=filled, fillcolor="lightblue", label="Git Repository", id="Git_Repository"];
    
    
  }
  
  
    
  subgraph cluster_build_server {
    label="Build Server";
    "__hidden_node_build_server" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="orange";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "CI/CD System" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>CI/CD System</TD></TR></TABLE>>, id="CI_CD_System"];
    
    
    "CIServer" [shape=box, style=filled, fillcolor="lightblue", label="CIServer", id="CIServer"];
    
    
  }
  
  
    
  subgraph cluster_artifact_registry {
    label="Artifact Registry";
    "__hidden_node_artifact_registry" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="purple";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "ArtifactRegistry" [shape=box, style=filled, fillcolor="lightblue", label="ArtifactRegistry", id="ArtifactRegistry"];
    
    
  }
  
  
    
  subgraph cluster_production_environment {
    label="Production Environment";
    "__hidden_node_production_environment" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="green";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "KubeCluster" [shape=box, style=filled, fillcolor="lightblue", label="KubeCluster", id="KubeCluster"];
    
    
  }
  
  

  

  

  
  "Developer" -> "Git Repository" [label="", label=<Push Code<BR/>Protocol: HTTPS/SSH>, id="edge_Developer_Git_Repository", fontsize=7, class="protocol-HTTPS_SSH"];
  
  "Git Repository" -> "CIServer" [label="", color="darkgreen", style="solid", label=<Webhook Trigger<BR/>Protocol: HTTPS>, id="edge_Git_Repository_CIServer", fontsize=7, class="protocol-HTTPS"];
  
  "CIServer" -> "Git Repository" [label="", label=<Fetch Code<BR/>Protocol: HTTPS/SSH>, id="edge_CIServer_Git_Repository", fontsize=7, class="protocol-HTTPS_SSH"];
  
  "CIServer" -> "ArtifactRegistry" [label="", color="darkgreen", style="solid", label=<Build Application<BR/>Protocol: HTTPS>, id="edge_CIServer_ArtifactRegistry", fontsize=7, class="protocol-HTTPS"];
  
  "KubeCluster" -> "ArtifactRegistry" [label="", color="darkgreen", style="solid", label=<Pull Artifact<BR/>Protocol: HTTPS>, id="edge_KubeCluster_ArtifactRegistry", fontsize=7, class="protocol-HTTPS"];
  
  "CIServer" -> "KubeCluster" [label="", label=<Deploy Application<BR/>Protocol: API/SSH>, id="edge_CIServer_KubeCluster", fontsize=7, class="protocol-API_SSH"];
  

  
}