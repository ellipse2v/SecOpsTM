digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_client__browser_mobile_ {
    label="Client (Browser/Mobile)";
    "__hidden_node_client__browser_mobile_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightblue";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "End User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>End User</TD></TR></TABLE>>, id="End_User"];
    
    
    
  }
  
  
    
  subgraph cluster_api_gateway {
    label="API Gateway";
    "__hidden_node_api_gateway" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "APIGateway" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">APIGateway</TD></TR></TABLE>>, id="APIGateway"];
    
    
  }
  
  
    
  subgraph cluster_microservice_a {
    label="Microservice A";
    "__hidden_node_microservice_a" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="green";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "UserService" [shape=box, style=filled, fillcolor="lightblue", label="UserService", id="UserService"];
    
    
  }
  
  
    
  subgraph cluster_microservice_b {
    label="Microservice B";
    "__hidden_node_microservice_b" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="blue";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "ProductService" [shape=box, style=filled, fillcolor="lightblue", label="ProductService", id="ProductService"];
    
    
  }
  
  
    
  subgraph cluster_shared_dedicated_database {
    label="Shared/Dedicated Database";
    "__hidden_node_shared_dedicated_database" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="purple";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "AppDatabase" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>AppDatabase</TD></TR></TABLE>>, id="AppDatabase"];
    
    
  }
  
  

  
  "Developer/Operator" [fixedsize=shape, shape=circle, style=filled, fillcolor="gray", color="gray", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Developer/Operator</TD></TR></TABLE>>, id="Developer_Operator"];
  

  
  "Load Balancer" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>Load Balancer</TD></TR></TABLE>>, id="Load_Balancer"];
  
  "ServiceDiscovery" [shape=box, style=filled, fillcolor="lightblue", label="ServiceDiscovery", id="ServiceDiscovery"];
  
  "MessageBroker" [shape=box, style=filled, fillcolor="lightblue", label="MessageBroker", id="MessageBroker"];
  

  
  "End User" -> "Load Balancer" [label="", color="darkgreen", style="solid", label=<Client Request<BR/>Protocol: HTTPS>, id="edge_End_User_Load_Balancer", fontsize=7, class="protocol-HTTPS"];
  
  "Load Balancer" -> "APIGateway" [label="", color="darkgreen", style="solid", label=<API Request<BR/>Protocol: HTTPS>, id="edge_Load_Balancer_APIGateway", fontsize=7, class="protocol-HTTPS"];
  
  "APIGateway" -> "UserService" [label="", color="blue", style="solid", label=<Sync Request<BR/>Protocol: HTTP/gRPC>, id="edge_APIGateway_UserService", fontsize=7, class="protocol-HTTP_gRPC"];
  
  "UserService" -> "MessageBroker" [label="", color="purple", style="dashed", label=<Async Event<BR/>Protocol: AMQP/Kafka>, id="edge_UserService_MessageBroker", fontsize=7, class="protocol-AMQP_Kafka"];
  
  "MessageBroker" -> "ProductService" [label="", color="purple", style="dashed", label=<Message Consume<BR/>Protocol: AMQP/Kafka>, id="edge_MessageBroker_ProductService", fontsize=7, class="protocol-AMQP_Kafka"];
  
  "UserService" -> "AppDatabase" [label="", color="orange", style="dashed", label=<DB Access<BR/>Protocol: JDBC/API>, id="edge_UserService_AppDatabase", fontsize=7, class="protocol-JDBC_API"];
  

  
}