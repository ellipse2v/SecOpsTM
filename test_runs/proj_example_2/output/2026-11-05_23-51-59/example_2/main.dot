digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  

  
  "User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>User</TD></TR></TABLE>>, id="User"];
  

  
  "WebApp" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">WebApp</TD></TR></TABLE>>, id="WebApp"];
  
  "BackendServices" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">BackendServices</TD></TR></TABLE>>, id="BackendServices"];
  

  
  "User" -> "WebApp" [label="", color="darkgreen", style="solid", label=<UserToWebApp<BR/>Protocol: HTTPS<BR/>Data: User Request>, id="edge_User_WebApp", fontsize=7, class="protocol-HTTPS"];
  
  "WebApp" -> "BackendServices" [label="", color="red", style="solid", label=<WebAppToBackend<BR/>Protocol: HTTP<BR/>Data: API Call>, id="edge_WebApp_BackendServices", fontsize=7, class="protocol-HTTP"];
  

  
}