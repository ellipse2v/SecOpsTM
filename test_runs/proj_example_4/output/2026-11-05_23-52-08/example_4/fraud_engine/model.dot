digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_scoring_zone {
    label="Scoring Zone";
    "__hidden_node_scoring_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightyellow";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "MLEngine" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">MLEngine</TD></TR></TABLE>>, id="MLEngine"];
    
    "RulesEngine" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">RulesEngine</TD></TR></TABLE>>, id="RulesEngine"];
    
    
  }
  
  
    
  subgraph cluster_analytics_zone {
    label="Analytics Zone";
    "__hidden_node_analytics_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightcyan";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "FeatureStore" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>FeatureStore</TD></TR></TABLE>>, id="FeatureStore"];
    
    "AlertService" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">AlertService</TD></TR></TABLE>>, id="AlertService"];
    
    
  }
  
  

  

  

  
  "MLEngine" -> "FeatureStore" [label="", color="crimson", style="solid", label=<MLToFeatureStore<BR/>Protocol: Redis<BR/>Data: BehavioralFeature>, id="edge_MLEngine_FeatureStore", fontsize=7, class="protocol-Redis"];
  
  "RulesEngine" -> "FeatureStore" [label="", color="crimson", style="solid", label=<RulesToFeatureStore<BR/>Protocol: Redis<BR/>Data: BehavioralFeature>, id="edge_RulesEngine_FeatureStore", fontsize=7, class="protocol-Redis"];
  
  "MLEngine" -> "AlertService" [label="", color="orange", style="dashed", label=<MLToAlert<BR/>Protocol: HTTP<BR/>Data: FraudDecision>, id="edge_MLEngine_AlertService", fontsize=7, class="protocol-HTTP"];
  
  "RulesEngine" -> "AlertService" [label="", color="orange", style="dashed", label=<RulesToAlert<BR/>Protocol: HTTP<BR/>Data: FraudDecision>, id="edge_RulesEngine_AlertService", fontsize=7, class="protocol-HTTP"];
  

  
  
  
  
  subgraph cluster__external_parent_in {
    label="External connections in (parent model)";
    style="dashed,filled";
    fillcolor="#e8f5e9";
    color="#66bb6a";
    penwidth=1;
    fontsize=9;
    fontcolor="#2e7d32";
    
    
    
    
    "__ghost_APIGateway" [label="APIGateway", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
  }
  
  "__ghost_APIGateway" -> "MLEngine" [style=dashed, color="#66bb6a", label="gRPC", fontsize=7, arrowsize=0.7];
  
  
  
  subgraph cluster__external_parent_out {
    label="External connections out (parent model)";
    style="dashed,filled";
    fillcolor="#fff3e0";
    color="#ffa726";
    penwidth=1;
    fontsize=9;
    fontcolor="#e65100";
    
    
    
    
    "__ghost_APIGateway" [label="APIGateway", shape=ellipse, style="dashed,filled", fillcolor="#ffe0b2", color="#ffa726", fontcolor="#bf360c", fontsize=9];
    
    
  }
  
  "MLEngine" -> "__ghost_APIGateway" [style=dashed, color="#ffa726", label="gRPC", fontsize=7, arrowsize=0.7];
  
  
  
}