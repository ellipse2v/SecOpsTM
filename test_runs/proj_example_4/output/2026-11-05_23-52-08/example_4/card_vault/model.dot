digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_hsm_zone {
    label="HSM Zone";
    "__hidden_node_hsm_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lavender";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "TokenProxy" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">TokenProxy</TD></TR></TABLE>>, id="TokenProxy"];
    
    "HSM" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">HSM</TD></TR></TABLE>>, id="HSM"];
    
    
  }
  
  
    
  subgraph cluster_vault_data_zone {
    label="Vault Data Zone";
    "__hidden_node_vault_data_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightpurple";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "VaultDB" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>VaultDB</TD></TR></TABLE>>, id="VaultDB"];
    
    
  }
  
  

  

  

  
  "TokenProxy" -> "HSM" [label="", color="darkpurple", style="solid", label=<ProxyToHSM<BR/>Protocol: PKCS11<BR/>Data: TokenizeRequest>, id="edge_TokenProxy_HSM", fontsize=7, class="protocol-PKCS11"];
  
  "TokenProxy" -> "VaultDB" [label="", color="blue", style="solid", label=<ProxyToVaultDB<BR/>Protocol: PostgreSQL<BR/>Data: VaultToken>, id="edge_TokenProxy_VaultDB", fontsize=7, class="protocol-PostgreSQL"];
  

  
  
  
  
  subgraph cluster__external_parent_in {
    label="External connections in (parent model)";
    style="dashed,filled";
    fillcolor="#e8f5e9";
    color="#66bb6a";
    penwidth=1;
    fontsize=9;
    fontcolor="#2e7d32";
    
    
    
    
    "__ghost_PaymentAPI" [label="PaymentAPI", shape=ellipse, style="dashed,filled", fillcolor="#c8e6c9", color="#66bb6a", fontcolor="#1b5e20", fontsize=9];
    
    
  }
  
  "__ghost_PaymentAPI" -> "TokenProxy" [style=dashed, color="#66bb6a", label="gRPC", fontsize=7, arrowsize=0.7];
  
  
  
  subgraph cluster__external_parent_out {
    label="External connections out (parent model)";
    style="dashed,filled";
    fillcolor="#fff3e0";
    color="#ffa726";
    penwidth=1;
    fontsize=9;
    fontcolor="#e65100";
    
    
    
    
    "__ghost_PaymentAPI" [label="PaymentAPI", shape=ellipse, style="dashed,filled", fillcolor="#ffe0b2", color="#ffa726", fontcolor="#bf360c", fontsize=9];
    
    
  }
  
  "TokenProxy" -> "__ghost_PaymentAPI" [style=dashed, color="#ffa726", label="gRPC", fontsize=7, arrowsize=0.7];
  
  
  
}