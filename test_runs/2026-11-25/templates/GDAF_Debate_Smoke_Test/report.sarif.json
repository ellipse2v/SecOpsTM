              "name": "Spoofing",
              "shortDescription": {
                "text": "[LOW] Spoofing \u2014 AttackerToServer"
              },
              "fullDescription": {
                "text": "Spoofing of data from External Attacker to Target Server due to lack of authentication"
              },
              "helpUri": "https://attack.mitre.org/techniques/T1557",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
