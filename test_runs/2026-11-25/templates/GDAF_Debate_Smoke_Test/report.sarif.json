              "name": "Spoofing",
              "shortDescription": {
                "text": "[MEDIUM] Spoofing \u2014 AttackerToServer"
              },
              "fullDescription": {
                "text": "Potential for spoofing attacks on data crossing trust boundaries from External Attacker to Target Server without proper authentication"
              },
              "helpUri": "https://attack.mitre.org/techniques/T1557",
              "defaultConfiguration": {
                "level": "warning"
