              "id": "T-0001",
              "name": "Tampering",
              "shortDescription": {
                "text": "[HIGH] Tampering \u2014 External Attacker"
              },
              "fullDescription": {
                "text": "Untrusted actor External Attacker may attempt to inject malicious data or exploit vulnerabilities in connected systems."
              },
              "helpUri": "https://attack.mitre.org/techniques/T1190",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "stride/Tampering",
                  "attack/T1190",
                  "attack/T1059"
                ],
                "security-severity": "8.2"
              }
            },
            {
              "id": "T-0002",
              "name": "ElevationofPrivilege",
              "shortDescription": {
                "text": "[MEDIUM] Elevation of Privilege \u2014 External Attacker"
              },
              "fullDescription": {
                "text": "Privilege abuse by actor External Attacker to gain unauthorized access or perform unauthorized actions"
              },
              "helpUri": "https://attack.mitre.org/techniques/T1078",
              "defaultConfiguration": {
                "level": "warning"
              },
