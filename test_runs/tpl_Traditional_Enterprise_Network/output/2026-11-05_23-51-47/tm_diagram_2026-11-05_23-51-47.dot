digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internal_network {
    label="Internal Network";
    "__hidden_node_internal_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="green";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Employee" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Employee</TD></TR></TABLE>>, id="Employee"];
    
    "System Administrator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>System Administrator</TD></TR></TABLE>>, id="System_Administrator"];
    
    
    "DomainController" [shape=box, style=filled, fillcolor="lightblue", label="DomainController", id="DomainController"];
    
    "File Server" [shape=box, style=filled, fillcolor="lightblue", label="File Server", id="File_Server"];
    
    "Application Server" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Application Server</TD></TR></TABLE>>, id="Application_Server"];
    
    
  }
  
  
    
  subgraph cluster_dmz__demilitarized_zone_ {
    label="DMZ (Demilitarized Zone)";
    "__hidden_node_dmz__demilitarized_zone_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "DMZWebServer" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">DMZWebServer</TD></TR></TABLE>>, id="DMZWebServer"];
    
    
  }
  
  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="red";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "ExternalUser" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>ExternalUser</TD></TR></TABLE>>, id="ExternalUser"];
    
    
    
  }
  
  

  

  
  "Firewall" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>Firewall</TD></TR></TABLE>>, id="Firewall"];
  

  
  "Employee" -> "DomainController" [label="", color="purple", style="solid", label=<User Authentication<BR/>Protocol: Kerberos/LDAP>, id="edge_Employee_DomainController", fontsize=7, class="protocol-Kerberos_LDAP"];
  
  "Employee" -> "File Server" [label="", color="blue", style="dashed", label=<File Access<BR/>Protocol: SMB>, id="edge_Employee_File_Server", fontsize=7, class="protocol-SMB"];
  
  "Employee" -> "Application Server" [label="", color="darkgreen", style="solid", label=<Internal App Access<BR/>Protocol: HTTPS>, id="edge_Employee_Application_Server", fontsize=7, class="protocol-HTTPS"];
  
  "ExternalUser" -> "Firewall" [label="", color="darkgreen", style="solid", label=<External Web Request<BR/>Protocol: HTTPS>, id="edge_ExternalUser_Firewall", fontsize=7, class="protocol-HTTPS"];
  
  "Firewall" -> "DMZWebServer" [label="", color="darkgreen", style="solid", label=<Internal Web Request<BR/>Protocol: HTTPS>, id="edge_Firewall_DMZWebServer", fontsize=7, class="protocol-HTTPS"];
  
  "DomainController" -> "DomainController" [dir="both", label="
↔️ Bidirectional", color="gray", style="dashed", label=<AD Replication<BR/>Protocol: RPC/LDAP>, id="edge_DomainController_DomainController", fontsize=7, class="protocol-RPC_LDAP"];
  
  "System Administrator" -> "DomainController" [label="", color="gray", style="dashed", label=<Admin Management<BR/>Protocol: RPC/SMB>, id="edge_System_Administrator_DomainController", fontsize=7, class="protocol-RPC_SMB"];
  

  
}