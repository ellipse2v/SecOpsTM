digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_client__web_browser_ {
    label="Client (Web Browser)";
    "__hidden_node_client__web_browser_" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightblue";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "End User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>End User</TD></TR></TABLE>>, id="End_User"];
    
    
    
  }
  
  
    
  subgraph cluster_monolithic_web_server {
    label="Monolithic Web Server";
    "__hidden_node_monolithic_web_server" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "MonolithicApp" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">MonolithicApp</TD></TR></TABLE>>, id="MonolithicApp"];
    
    
  }
  
  
    
  subgraph cluster_database {
    label="Database";
    "__hidden_node_database" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="purple";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "DatabaseServer" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>DatabaseServer</TD></TR></TABLE>>, id="DatabaseServer"];
    
    
  }
  
  

  
  "Administrator" [fixedsize=shape, shape=circle, style=filled, fillcolor="gray", color="gray", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Administrator</TD></TR></TABLE>>, id="Administrator"];
  

  
  "LoadBalancer" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>LoadBalancer</TD></TR></TABLE>>, id="LoadBalancer"];
  

  
  "End User" -> "LoadBalancer" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<HTTP/S Request<BR/>Protocol: HTTPS>, id="edge_End_User_LoadBalancer", fontsize=7, class="protocol-HTTPS"];
  
  "LoadBalancer" -> "MonolithicApp" [dir="both", label="
↔️ Bidirectional", color="orange", label=<Web Request<BR/>Protocol: HTTP/S>, id="edge_LoadBalancer_MonolithicApp", fontsize=7, class="protocol-HTTP_S"];
  
  "MonolithicApp" -> "DatabaseServer" [dir="both", label="
↔️ Bidirectional", color="purple", style="dashed", label=<Database Request<BR/>Protocol: JDBC/ODBC/API>, id="edge_MonolithicApp_DatabaseServer", fontsize=7, class="protocol-JDBC_ODBC_API"];
  

  
}