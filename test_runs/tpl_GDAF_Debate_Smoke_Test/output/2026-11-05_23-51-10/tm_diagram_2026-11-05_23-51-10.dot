digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "External Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Attacker</TD></TR></TABLE>>, id="External_Attacker"];
    
    
    
  }
  
  
    
  subgraph cluster_internal_network {
    label="Internal Network";
    "__hidden_node_internal_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Target Server" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD></TR><TR><TD>Target Server</TD></TR></TABLE>>, id="Target_Server"];
    
    
  }
  
  

  

  

  
  "External Attacker" -> "Target Server" [label="", label=<AttackerToServer<BR/>Protocol: HTTPS<BR/>🔒 Encrypted>, id="edge_External_Attacker_Target_Server", fontsize=7, class="protocol-HTTPS"];
  

  
}