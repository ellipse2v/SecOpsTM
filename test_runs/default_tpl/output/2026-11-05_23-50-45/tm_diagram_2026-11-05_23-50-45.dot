digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="#F0F0F0";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "External Client 1" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 1</TD></TR></TABLE>>, id="External_Client_1"];
    
    "External Client 2" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 2</TD></TR></TABLE>>, id="External_Client_2"];
    
    "External Client 3" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 3</TD></TR></TABLE>>, id="External_Client_3"];
    
    "External Client 4" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 4</TD></TR></TABLE>>, id="External_Client_4"];
    
    "External Client 5" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 5</TD></TR></TABLE>>, id="External_Client_5"];
    
    "External Client 6" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 6</TD></TR></TABLE>>, id="External_Client_6"];
    
    "External Client 7" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 7</TD></TR></TABLE>>, id="External_Client_7"];
    
    "External Client 8" [fixedsize=shape, shape=circle, style=filled, fillcolor="#ADD8E6", color="#ADD8E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Client 8</TD></TR></TABLE>>, id="External_Client_8"];
    
    
    
  }
  
  
    
  subgraph cluster_dmz {
    label="DMZ";
    "__hidden_node_dmz" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="khaki";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "External Firewall" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="#D3D3D3", color="#D3D3D3", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Firewall</TD></TR></TABLE>>, id="External_Firewall"];
    
    "Protocol Break Device" [shape=box, style=filled, fillcolor="lightblue", label="Protocol Break Device", id="Protocol_Break_Device"];
    
    "Internal Firewall" [fixedsize=shape, shape=hexagon, style=filled, fillcolor="#D3D3D3", color="#D3D3D3", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/firewall.svg" SCALE="TRUE"/></TD></TR><TR><TD>Internal Firewall</TD></TR></TABLE>>, id="Internal_Firewall"];
    
    
  }
  
  
    
  subgraph cluster_gateway_zone {
    label="Gateway_Zone";
    "__hidden_node_gateway_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightyellow";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Gateway Load Balancer" [shape=cylinder, style=filled, fillcolor="gold", color="gold", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>Gateway Load Balancer</TD></TR></TABLE>>, id="Gateway_Load_Balancer"];
    
    "App Server 1" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="#B0E0E6", color="#B0E0E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">App Server 1</TD></TR></TABLE>>, id="App_Server_1"];
    
    "App Server 2" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="#B0E0E6", color="#B0E0E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">App Server 2</TD></TR></TABLE>>, id="App_Server_2"];
    
    "App Server 3" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="#B0E0E6", color="#B0E0E6", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">App Server 3</TD></TR></TABLE>>, id="App_Server_3"];
    
    
  }
  
  
    
  subgraph cluster_intranet {
    label="Intranet";
    "__hidden_node_intranet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,solid";
    
    fillcolor="none";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Internal Operator 1" [fixedsize=shape, shape=circle, style=filled, fillcolor="forestgreen", color="forestgreen", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Internal Operator 1</TD></TR></TABLE>>, id="Internal_Operator_1"];
    
    "Internal Operator 2" [fixedsize=shape, shape=circle, style=filled, fillcolor="forestgreen", color="forestgreen", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Internal Operator 2</TD></TR></TABLE>>, id="Internal_Operator_2"];
    
    "System Administrator" [fixedsize=shape, shape=circle, style=filled, fillcolor="forestgreen", color="forestgreen", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>System Administrator</TD></TR></TABLE>>, id="System_Administrator"];
    
    
    "Switch" [shape=box, style=filled, fillcolor="#E6E6FA", color="#E6E6FA", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/switch.svg" SCALE="TRUE"/></TD></TR><TR><TD>Switch</TD></TR></TABLE>>, id="Switch"];
    
    "Central Server" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="#98FB98", color="#98FB98", label=<🖥️ <br/>Central Server>, id="Central_Server"];
    
    "Application Database" [shape=cylinder, style=filled, fillcolor="#FFDAB9", color="#FFDAB9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>Application Database</TD></TR></TABLE>>, id="Application_Database"];
    
    "Authentication Server" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<🖥️ <br/>Authentication Server>, id="Authentication_Server"];
    
    
  }
  
  
    
  subgraph cluster_command_zone {
    label="Command_Zone";
    "__hidden_node_command_zone" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="#F0F0F0";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Command Machine" [shape=box, style=filled, fillcolor="lightblue", label="Command Machine", id="Command_Machine"];
    
    
  }
  
  

  

  

  
  "External Client 1" -> "External Firewall" [dir="both", label="
↔️ Bidirectional", color="darkgreen", style="solid", label=<test1<BR/>Protocol: HTTPS<BR/>Data: Web Traffic<BR/>🔒 Encrypted>, id="edge_External_Client_1_External_Firewall", fontsize=7, class="protocol-HTTPS"];
  
  "External Client 2" -> "External Firewall" [label="", color="red", style="solid", label=<test<BR/>Protocol: HTTP<BR/>Data: Web Traffic>, id="edge_External_Client_2_External_Firewall", fontsize=7, class="protocol-HTTP"];
  
  "External Client 3" -> "External Firewall" [label="", label=<Client 3 to External Firewall<BR/>Protocol: FTP<BR/>Data: File Transfer>, id="edge_External_Client_3_External_Firewall", fontsize=7, class="protocol-FTP"];
  
  "External Client 4" -> "External Firewall" [label="", label=<Client 4 to External Firewall<BR/>Protocol: SFTP<BR/>Data: File Transfer<BR/>🔒 Encrypted>, id="edge_External_Client_4_External_Firewall", fontsize=7, class="protocol-SFTP"];
  
  "External Client 5" -> "External Firewall" [label="", label=<Client 5 to External Firewall<BR/>Protocol: DNS<BR/>Data: DNS Query>, id="edge_External_Client_5_External_Firewall", fontsize=7, class="protocol-DNS"];
  
  "External Client 6" -> "External Firewall" [label="", label=<Client 6 to External Firewall<BR/>Protocol: SMTP<BR/>Data: Mail Traffic>, id="edge_External_Client_6_External_Firewall", fontsize=7, class="protocol-SMTP"];
  
  "External Client 7" -> "External Firewall" [label="", label=<Client 7 to External Firewall<BR/>Protocol: RTSP<BR/>Data: Video Stream>, id="edge_External_Client_7_External_Firewall", fontsize=7, class="protocol-RTSP"];
  
  "External Client 8" -> "External Firewall" [label="", color="teal", style="dashed", label=<Client 8 to External Firewall<BR/>Protocol: MQTT<BR/>Data: IoT Data>, id="edge_External_Client_8_External_Firewall", fontsize=7, class="protocol-MQTT"];
  
  "External Firewall" -> "Protocol Break Device" [label="", color="darkgreen", style="solid", label=<External Firewall to Protocol Break Device<BR/>Protocol: HTTPS<BR/>Data: Web Traffic<BR/>🔒 Encrypted>, id="edge_External_Firewall_Protocol_Break_Device", fontsize=7, class="protocol-HTTPS"];
  
  "Protocol Break Device" -> "Internal Firewall" [label="", color="darkgreen", style="solid", label=<Protocol Break Device to Internal Firewall<BR/>Protocol: HTTPS<BR/>Data: Web Traffic<BR/>🔒 Encrypted>, id="edge_Protocol_Break_Device_Internal_Firewall", fontsize=7, class="protocol-HTTPS"];
  
  "Internal Firewall" -> "Gateway Load Balancer" [label="", color="darkgreen", style="solid", label=<Internal Firewall to Gateway Load Balancer<BR/>Protocol: HTTPS<BR/>Data: Web Traffic<BR/>🔒 Encrypted>, id="edge_Internal_Firewall_Gateway_Load_Balancer", fontsize=7, class="protocol-HTTPS"];
  
  "Gateway Load Balancer" -> "App Server 1" [label="", color="darkgreen", style="solid", label=<Gateway Load Balancer to App Server 1<BR/>Protocol: HTTPS<BR/>Data: API Request<BR/>🔒 Encrypted>, id="edge_Gateway_Load_Balancer_App_Server_1", fontsize=7, class="protocol-HTTPS"];
  
  "Gateway Load Balancer" -> "App Server 2" [label="", color="darkgreen", style="solid", label=<Gateway Load Balancer to App Server 2<BR/>Protocol: HTTPS<BR/>Data: API Request<BR/>🔒 Encrypted>, id="edge_Gateway_Load_Balancer_App_Server_2", fontsize=7, class="protocol-HTTPS"];
  
  "Gateway Load Balancer" -> "App Server 3" [label="", color="darkgreen", style="solid", label=<Gateway Load Balancer to App Server 3<BR/>Protocol: HTTPS<BR/>Data: API Request<BR/>🔒 Encrypted>, id="edge_Gateway_Load_Balancer_App_Server_3", fontsize=7, class="protocol-HTTPS"];
  
  "App Server 1" -> "Switch" [label="", label=<App Server 1 to Switch<BR/>Protocol: Ethernet<BR/>Data: General Traffic>, id="edge_App_Server_1_Switch", fontsize=7, class="protocol-Ethernet"];
  
  "App Server 2" -> "Switch" [label="", label=<App Server 2 to Switch<BR/>Protocol: Ethernet<BR/>Data: General Traffic>, id="edge_App_Server_2_Switch", fontsize=7, class="protocol-Ethernet"];
  
  "App Server 3" -> "Switch" [label="", label=<App Server 3 to Switch<BR/>Protocol: Ethernet<BR/>Data: General Traffic>, id="edge_App_Server_3_Switch", fontsize=7, class="protocol-Ethernet"];
  
