↔️ Bidirectional", color="darkgreen", style="solid", label=<Switch to Central Server<BR/>Protocol: HTTPS<BR/>Data: Server Request<BR/>🔒 Encrypted<BR/>🔐 Authenticated>, id="edge_Switch_Central_Server", fontsize=7, class="protocol-HTTPS"];
  
  "System Administrator" -> "Central Server" [label="", color="blue", style="dashed", label=<System Administrator to Central Server<BR/>Protocol: SSH<BR/>Data: SSH Traffic<BR/>🔒 Encrypted<BR/>🔐 Authenticated>, id="edge_System_Administrator_Central_Server", fontsize=7, class="protocol-SSH"];
  
  "System Administrator" -> "Authentication Server" [label="", color="teal", label=<System Administrator to Authentication Server<BR/>Protocol: LDAPS<BR/>Data: Authentication Request<BR/>🔒 Encrypted<BR/>🔐 Authenticated>, id="edge_System_Administrator_Authentication_Server", fontsize=7, class="protocol-LDAPS"];
  
