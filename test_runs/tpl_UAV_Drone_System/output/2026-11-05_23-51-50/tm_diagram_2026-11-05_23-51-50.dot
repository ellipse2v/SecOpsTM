digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_airborne {
    label="Airborne";
    "__hidden_node_airborne" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="#e3f2fd";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Aircraft Flight Controller" [shape=box, style=filled, fillcolor="lightblue", label="Aircraft Flight Controller", id="Aircraft_Flight_Controller"];
    
    "Aircraft Payload System" [shape=box, style=filled, fillcolor="lightblue", label="Aircraft Payload System", id="Aircraft_Payload_System"];
    
    "Aircraft Onboard Storage" [shape=box, style=filled, fillcolor="lightblue", label="Aircraft Onboard Storage", id="Aircraft_Onboard_Storage"];
    
    
  }
  
  
    
  subgraph cluster_ground_station {
    label="Ground Station";
    "__hidden_node_ground_station" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="#fff3e0";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Drone Pilot" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Drone Pilot</TD></TR></TABLE>>, id="Drone_Pilot"];
    
    "Negligent Operator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Negligent Operator</TD></TR></TABLE>>, id="Negligent_Operator"];
    
    
    "RC Plus Controller" [shape=box, style=filled, fillcolor="lightblue", label="RC Plus Controller", id="RC_Plus_Controller"];
    
    "Mobile Device" [shape=box, style=filled, fillcolor="lightblue", label="Mobile Device", id="Mobile_Device"];
    
    
  }
  
  
    
  subgraph cluster_office_backend {
    label="Office Backend";
    "__hidden_node_office_backend" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="#e8f5e9";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Data Analyst" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Data Analyst</TD></TR></TABLE>>, id="Data_Analyst"];
    
    "Fleet Manager" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Fleet Manager</TD></TR></TABLE>>, id="Fleet_Manager"];
    
    
    "Analysis Workstation" [shape=box, style=filled, fillcolor="lightblue", label="Analysis Workstation", id="Analysis_Workstation"];
    
    
  }
  
  
    
  subgraph cluster_cloud_external {
    label="Cloud External";
    "__hidden_node_cloud_external" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="#fce4ec";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Nation State Actor" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Nation State Actor</TD></TR></TABLE>>, id="Nation_State_Actor"];
    
    "Criminal Organization" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Criminal Organization</TD></TR></TABLE>>, id="Criminal_Organization"];
    
    
    "DJI FlightHub 2" [shape=box, style=filled, fillcolor="lightblue", label="DJI FlightHub 2", id="DJI_FlightHub_2"];
    
    "DJI Account Servers" [shape=box, style=filled, fillcolor="lightblue", label="DJI Account Servers", id="DJI_Account_Servers"];
    
    "RTK Service" [shape=box, style=filled, fillcolor="lightblue", label="RTK Service", id="RTK_Service"];
    
    "Livestream Servers" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD></TR><TR><TD>Livestream Servers</TD></TR></TABLE>>, id="Livestream_Servers"];
    
    
  }
  
  
    
  subgraph cluster_supply_chain {
    label="Supply Chain";
    "__hidden_node_supply_chain" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dotted";
    
    fillcolor="#f3e5f5";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "DJI Manufacturer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>DJI Manufacturer</TD></TR></TABLE>>, id="DJI_Manufacturer"];
    
    
    
  }
  
  

  

  

  
  "RC Plus Controller" -> "Aircraft Flight Controller" [dir="both", label="
↔️ Bidirectional", color="#1976d2", description="DJI O3 Enterprise proprietary transmission protocol with AES-256 encryption for video and data.", lineStyle="solid", labelColor="#ffffff", label=<Mission Plan Upload<BR/>Protocol: o3-enterprise<BR/>Data: Mission Plans>, id="edge_RC_Plus_Controller_Aircraft_Flight_Controller", fontsize=7, class="protocol-o3_enterprise"];
  
  "Aircraft Payload System" -> "RC Plus Controller" [label="", color="#1976d2", description="DJI O3 Enterprise proprietary transmission protocol with AES-256 encryption for video and data.", lineStyle="solid", labelColor="#ffffff", label=<Live Video Feed<BR/>Protocol: o3-enterprise<BR/>Data: Inspection Imagery>, id="edge_Aircraft_Payload_System_RC_Plus_Controller", fontsize=7, class="protocol-o3_enterprise"];
  
  "Aircraft Payload System" -> "Aircraft Onboard Storage" [label="", color="#5d4037", description="Internal hardware bus for onboard data storage.", lineStyle="solid", labelColor="#ffffff", label=<Media Storage Onboard<BR/>Protocol: internal-bus<BR/>Data: Inspection Imagery>, id="edge_Aircraft_Payload_System_Aircraft_Onboard_Storage", fontsize=7, class="protocol-internal_bus"];
  
  "Aircraft Onboard Storage" -> "RC Plus Controller" [label="", color="#1976d2", description="DJI O3 Enterprise proprietary transmission protocol with AES-256 encryption for video and data.", lineStyle="solid", labelColor="#ffffff", label=<Media Transfer to RC<BR/>Protocol: o3-enterprise<BR/>Data: Inspection Imagery>, id="edge_Aircraft_Onboard_Storage_RC_Plus_Controller", fontsize=7, class="protocol-o3_enterprise"];
  
  "RTK Service" -> "Aircraft Flight Controller" [label="", color="#0097a7", description="NTRIP protocol over cellular network for RTK correction data.", lineStyle="dotted", labelColor="#ffffff", label=<RTK Correction Data<BR/>Protocol: ntrip<BR/>Data: Infrastructure Coordinates>, id="edge_RTK_Service_Aircraft_Flight_Controller", fontsize=7, class="protocol-ntrip"];
  
  "RC Plus Controller" -> "DJI FlightHub 2" [label="", color="#388e3c", description="Standard HTTPS protocol with TLS encryption for cloud communications.", lineStyle="solid", labelColor="#ffffff", label=<Cloud Data Sync<BR/>Protocol: https<BR/>Data: Flight Telemetry>, id="edge_RC_Plus_Controller_DJI_FlightHub_2", fontsize=7, class="protocol-https"];
  
  "DJI Account Servers" -> "Aircraft Flight Controller" [label="", color="#388e3c", description="Standard HTTPS protocol with TLS encryption for cloud communications.", lineStyle="solid", labelColor="#ffffff", label=<GEO Zone Update<BR/>Protocol: https<BR/>Data: Infrastructure Coordinates>, id="edge_DJI_Account_Servers_Aircraft_Flight_Controller", fontsize=7, class="protocol-https"];
  
  "Analysis Workstation" -> "Aircraft Flight Controller" [label="", color="#7b1fa2", description="SD card physical transfer for offline firmware updates.", lineStyle="dashed", labelColor="#ffffff", label=<Firmware Update Offline<BR/>Protocol: physical-media<BR/>Data: Device Information>, id="edge_Analysis_Workstation_Aircraft_Flight_Controller", fontsize=7, class="protocol-physical_media"];
  
  "RC Plus Controller" -> "Livestream Servers" [label="", color="#d32f2f", description="RTMP/RTSP protocol for live video streaming to third-party platforms.", lineStyle="dotted", labelColor="#ffffff", label=<Livestream Distribution<BR/>Protocol: rtmp<BR/>Data: Inspection Imagery>, id="edge_RC_Plus_Controller_Livestream_Servers", fontsize=7, class="protocol-rtmp"];
  
  "RC Plus Controller" -> "Analysis Workstation" [dir="both", label="
↔️ Bidirectional", color="#f57c00", description="USB mass storage protocol for physical data transfer.", lineStyle="dashed", labelColor="#ffffff", label=<Data Transfer to Workstation<BR/>Protocol: usb<BR/>Data: Inspection Imagery>, id="edge_RC_Plus_Controller_Analysis_Workstation", fontsize=7, class="protocol-usb"];
  
  "DJI Account Servers" -> "RC Plus Controller" [dir="both", label="
↔️ Bidirectional", color="#388e3c", description="Standard HTTPS protocol with TLS encryption for cloud communications.", lineStyle="solid", labelColor="#ffffff", label=<Map Data Download<BR/>Protocol: https<BR/>Data: Infrastructure Coordinates>, id="edge_DJI_Account_Servers_RC_Plus_Controller", fontsize=7, class="protocol-https"];
  
  "RC Plus Controller" -> "DJI Account Servers" [dir="both", label="
↔️ Bidirectional", color="#388e3c", description="Standard HTTPS protocol with TLS encryption for cloud communications.", lineStyle="solid", labelColor="#ffffff", label=<Account Authentication<BR/>Protocol: https<BR/>Data: User Credentials>, id="edge_RC_Plus_Controller_DJI_Account_Servers", fontsize=7, class="protocol-https"];
  

  
}