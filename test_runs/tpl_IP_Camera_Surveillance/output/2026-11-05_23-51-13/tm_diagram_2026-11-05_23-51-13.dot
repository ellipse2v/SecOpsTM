digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_physical_perimeter {
    label="Physical Perimeter";
    "__hidden_node_physical_perimeter" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "External Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>External Attacker</TD></TR></TABLE>>, id="External_Attacker"];
    
    
    "Cam-Thermal-Perimeter" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/thermal-camera.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cam-Thermal-Perimeter</TD></TR></TABLE>>, id="Cam_Thermal_Perimeter"];
    
    
  }
  
  
    
  subgraph cluster_camera_network {
    label="Camera Network";
    "__hidden_node_camera_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Cam-Entrance-01" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ip-camera.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cam-Entrance-01</TD></TR></TABLE>>, id="Cam_Entrance_01"];
    
    "Cam-Parking-PTZ" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ptz-camera.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cam-Parking-PTZ</TD></TR></TABLE>>, id="Cam_Parking_PTZ"];
    
    "Cam-Server-Room" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/ip-camera.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cam-Server-Room</TD></TR></TABLE>>, id="Cam_Server_Room"];
    
    "NVR-Main" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/nvr.svg" SCALE="TRUE"/></TD></TR><TR><TD>NVR-Main</TD></TR></TABLE>>, id="NVR_Main"];
    
    "RTSP-Relay" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/rtsp-server.svg" SCALE="TRUE"/></TD></TR><TR><TD>RTSP-Relay</TD></TR></TABLE>>, id="RTSP_Relay"];
    
    
  }
  
  
    
  subgraph cluster_management_network {
    label="Management Network";
    "__hidden_node_management_network" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    "Security Operator" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Security Operator</TD></TR></TABLE>>, id="Security_Operator"];
    
    
    "VMS-Server" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/vms.svg" SCALE="TRUE"/></TD></TR><TR><TD>VMS-Server</TD></TR></TABLE>>, id="VMS_Server"];
    
    
  }
  
  
    
  subgraph cluster_mobile_access {
    label="Mobile Access";
    "__hidden_node_mobile_access" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightgray";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "Mobile Viewer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Mobile Viewer</TD></TR></TABLE>>, id="Mobile_Viewer"];
    
    
    "Mobile-App-Server" [shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/api-gateway.svg" SCALE="TRUE"/></TD></TR><TR><TD>Mobile-App-Server</TD></TR></TABLE>>, id="Mobile_App_Server"];
    
    
  }
  
  
    
  subgraph cluster_cloud_storage {
    label="Cloud Storage";
    "__hidden_node_cloud_storage" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Cloud-Archive" [shape=box, style=filled, fillcolor="lightblue", label="Cloud-Archive", id="Cloud_Archive"];
    
    
  }
  
  

  

  

  
  "Cam-Entrance-01" -> "NVR-Main" [label="", color="orange", style="dashed", label=<Cam-to-NVR-01<BR/>Protocol: RTSP>, id="edge_Cam_Entrance_01_NVR_Main", fontsize=7, class="protocol-RTSP"];
  
  "Cam-Parking-PTZ" -> "NVR-Main" [label="", color="orange", style="dashed", label=<Cam-to-NVR-PTZ<BR/>Protocol: RTSP>, id="edge_Cam_Parking_PTZ_NVR_Main", fontsize=7, class="protocol-RTSP"];
  
  "Cam-Server-Room" -> "NVR-Main" [label="", color="orange", style="dashed", label=<Cam-to-NVR-Server<BR/>Protocol: RTSP>, id="edge_Cam_Server_Room_NVR_Main", fontsize=7, class="protocol-RTSP"];
  
  "Cam-Thermal-Perimeter" -> "NVR-Main" [label="", color="orange", style="dashed", label=<Thermal-to-NVR<BR/>Protocol: RTSP>, id="edge_Cam_Thermal_Perimeter_NVR_Main", fontsize=7, class="protocol-RTSP"];
  
  "NVR-Main" -> "VMS-Server" [label="", color="darkgreen", style="solid", label=<NVR-to-VMS<BR/>Protocol: HTTPS>, id="edge_NVR_Main_VMS_Server", fontsize=7, class="protocol-HTTPS"];
  
  "NVR-Main" -> "RTSP-Relay" [label="", color="orange", style="dashed", label=<NVR-to-RTSP<BR/>Protocol: RTSP>, id="edge_NVR_Main_RTSP_Relay", fontsize=7, class="protocol-RTSP"];
  
  "VMS-Server" -> "Cloud-Archive" [label="", color="darkgreen", style="solid", label=<VMS-to-Cloud<BR/>Protocol: HTTPS>, id="edge_VMS_Server_Cloud_Archive", fontsize=7, class="protocol-HTTPS"];
  
  "VMS-Server" -> "Cam-Parking-PTZ" [label="", color="darkorange", style="dashed", label=<VMS-to-PTZ-Control<BR/>Protocol: ONVIF>, id="edge_VMS_Server_Cam_Parking_PTZ", fontsize=7, class="protocol-ONVIF"];
  
  "Security Operator" -> "VMS-Server" [label="", color="darkgreen", style="solid", label=<Operator-to-VMS<BR/>Protocol: HTTPS>, id="edge_Security_Operator_VMS_Server", fontsize=7, class="protocol-HTTPS"];
  
  "Mobile Viewer" -> "Mobile-App-Server" [label="", color="darkgreen", style="solid", label=<Mobile-to-API<BR/>Protocol: HTTPS>, id="edge_Mobile_Viewer_Mobile_App_Server", fontsize=7, class="protocol-HTTPS"];
  
  "Mobile-App-Server" -> "RTSP-Relay" [label="", color="orange", style="dashed", label=<API-to-RTSP<BR/>Protocol: RTSP>, id="edge_Mobile_App_Server_RTSP_Relay", fontsize=7, class="protocol-RTSP"];
  
  "External Attacker" -> "Cam-Thermal-Perimeter" [label="", color="orange", style="dashed", label=<Attacker-to-Thermal<BR/>Protocol: RTSP>, id="edge_External_Attacker_Cam_Thermal_Perimeter", fontsize=7, class="protocol-RTSP"];
  

  
}