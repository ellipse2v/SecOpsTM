digraph ThreatModel {
  rankdir=LR;
  node [shape=box];
  edge [fontsize=10];
  splines=true;
  overlap=false;
  nodesep=0.5;
  ranksep=0.6;
  charset="UTF-8";

  

  
    
  subgraph cluster_internet {
    label="Internet";
    "__hidden_node_internet" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="lightcoral";
    
    
    color="#c62828";
    penwidth=2;
    
    
    "End User" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>End User</TD></TR></TABLE>>, id="End_User"];
    
    "Developer" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Developer</TD></TR></TABLE>>, id="Developer"];
    
    "CI/CD Pipeline" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>CI/CD Pipeline</TD></TR></TABLE>>, id="CI_CD_Pipeline"];
    
    "Attacker" [fixedsize=shape, shape=circle, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/actor.svg" SCALE="TRUE"/></TD></TR><TR><TD>Attacker</TD></TR></TABLE>>, id="Attacker"];
    
    
    
  }
  
  
    
  subgraph cluster_ingress___dmz {
    label="Ingress / DMZ";
    "__hidden_node_ingress___dmz" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,dashed";
    
    fillcolor="orange";
    
    
    color="#c62828";
    penwidth=2;
    
    
    
    "Cloud Load Balancer" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/load_balancer.svg" SCALE="TRUE"/></TD></TR><TR><TD>Cloud Load Balancer</TD></TR></TABLE>>, id="Cloud_Load_Balancer"];
    
    "Ingress Controller (Nginx)" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Ingress Controller (Nginx)</TD></TR></TABLE>>, id="Ingress_Controller__Nginx_"];
    
    
  }
  
  
    
  subgraph cluster_frontend_namespace {
    label="Frontend Namespace";
    "__hidden_node_frontend_namespace" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightyellow";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Frontend Pod (React SPA)" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Frontend Pod (React SPA)</TD></TR></TABLE>>, id="Frontend_Pod__React_SPA_"];
    
    
  }
  
  
    
  subgraph cluster_backend_namespace {
    label="Backend Namespace";
    "__hidden_node_backend_namespace" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgreen";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Backend API Pod (Node.js)" [shape=box, style=filled, fillcolor="lightblue", label="Backend API Pod (Node.js)", id="Backend_API_Pod__Node_js_"];
    
    "Worker Pod (async jobs)" [shape=box, style=filled, fillcolor="lightblue", label="Worker Pod (async jobs)", id="Worker_Pod__async_jobs_"];
    
    
  }
  
  
    
  subgraph cluster_data_namespace {
    label="Data Namespace";
    "__hidden_node_data_namespace" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightblue";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "PostgreSQL (StatefulSet)" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>PostgreSQL (StatefulSet)</TD></TR></TABLE>>, id="PostgreSQL__StatefulSet_"];
    
    "Redis (StatefulSet)" [shape=box, style=filled, fillcolor="lightblue", label="Redis (StatefulSet)", id="Redis__StatefulSet_"];
    
    "Message Broker (Kafka)" [shape=box, style=filled, fillcolor="lightblue", label="Message Broker (Kafka)", id="Message_Broker__Kafka_"];
    
    
  }
  
  
    
  subgraph cluster_platform_namespace {
    label="Platform Namespace";
    "__hidden_node_platform_namespace" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="mediumpurple";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Vault (Platform)" [shape=box, style=filled, fillcolor="lightblue", label="Vault (Platform)", id="Vault__Platform_"];
    
    "Cert-Manager" [shape=box, style=filled, fillcolor="lightblue", label="Cert-Manager", id="Cert_Manager"];
    
    "Container Registry (Harbor)" [shape=box, style=filled, fillcolor="lightblue", label="Container Registry (Harbor)", id="Container_Registry__Harbor_"];
    
    
  }
  
  
    
  subgraph cluster_observability_namespace {
    label="Observability Namespace";
    "__hidden_node_observability_namespace" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="lightgray";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "Prometheus + Alertmanager" [shape=box, style=filled, fillcolor="lightblue", label="Prometheus + Alertmanager", id="Prometheus___Alertmanager"];
    
    "Grafana" [width=1.5, height=0.75, shape=box, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/web-server.svg" SCALE="TRUE"/></TD><TD ALIGN="LEFT">Grafana</TD></TR></TABLE>>, id="Grafana"];
    
    
  }
  
  
    
  subgraph cluster_control_plane {
    label="Control Plane";
    "__hidden_node_control_plane" [style=invis, width=0, height=0, label=""];
    fontsize=10;
    style="rounded,filled,solid";
    
    fillcolor="darkred";
    
    
    color="#2e7d32";
    penwidth=2;
    
    
    
    "kube-apiserver" [shape=box, style=filled, fillcolor="lightblue", label="kube-apiserver", id="kube_apiserver"];
    
    "etcd" [shape=cylinder, style=filled, fillcolor="lightblue", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD WIDTH="30" HEIGHT="30" FIXEDSIZE="TRUE"><IMG SRC="/home/user/SecOpsTM/threat_analysis/server/static/resources/icons/database.svg" SCALE="TRUE"/></TD></TR><TR><TD>etcd</TD></TR></TABLE>>, id="etcd"];
    
    
  }
  
  

  

  

  
  "End User" -> "Cloud Load Balancer" [label="", color="darkgreen", style="solid", label=<User HTTPS Request<BR/>Protocol: HTTPS>, id="edge_End_User_Cloud_Load_Balancer", fontsize=7, class="protocol-HTTPS"];
  
  "Cloud Load Balancer" -> "Ingress Controller (Nginx)" [label="", color="darkgreen", style="solid", label=<LB to Ingress<BR/>Protocol: HTTPS>, id="edge_Cloud_Load_Balancer_Ingress_Controller__Nginx_", fontsize=7, class="protocol-HTTPS"];
  
  "Ingress Controller (Nginx)" -> "Frontend Pod (React SPA)" [label="", color="red", style="solid", label=<Ingress to Frontend<BR/>Protocol: HTTP>, id="edge_Ingress_Controller__Nginx__Frontend_Pod__React_SPA_", fontsize=7, class="protocol-HTTP"];
  
  "Ingress Controller (Nginx)" -> "Backend API Pod (Node.js)" [label="", color="red", style="solid", label=<Ingress to Backend API<BR/>Protocol: HTTP>, id="edge_Ingress_Controller__Nginx__Backend_API_Pod__Node_js_", fontsize=7, class="protocol-HTTP"];
  
  "Frontend Pod (React SPA)" -> "Backend API Pod (Node.js)" [label="", color="red", style="solid", label=<Frontend to Backend API<BR/>Protocol: HTTP>, id="edge_Frontend_Pod__React_SPA__Backend_API_Pod__Node_js_", fontsize=7, class="protocol-HTTP"];
  
  "Backend API Pod (Node.js)" -> "PostgreSQL (StatefulSet)" [label="", color="purple", style="solid", label=<Backend API to PostgreSQL<BR/>Protocol: PostgreSQL/TLS>, id="edge_Backend_API_Pod__Node_js__PostgreSQL__StatefulSet_", fontsize=7, class="protocol-PostgreSQL_TLS"];
  
  "Backend API Pod (Node.js)" -> "Redis (StatefulSet)" [label="", color="darkorange", style="solid", label=<Backend API to Redis<BR/>Protocol: Redis/TLS>, id="edge_Backend_API_Pod__Node_js__Redis__StatefulSet_", fontsize=7, class="protocol-Redis_TLS"];
  
  "Backend API Pod (Node.js)" -> "Message Broker (Kafka)" [label="", color="steelblue", style="dashed", label=<Backend API to Kafka<BR/>Protocol: Kafka/SASL>, id="edge_Backend_API_Pod__Node_js__Message_Broker__Kafka_", fontsize=7, class="protocol-Kafka_SASL"];
  
  "Worker Pod (async jobs)" -> "Message Broker (Kafka)" [label="", color="steelblue", style="dashed", label=<Worker to Kafka<BR/>Protocol: Kafka/SASL>, id="edge_Worker_Pod__async_jobs__Message_Broker__Kafka_", fontsize=7, class="protocol-Kafka_SASL"];
  
  "Worker Pod (async jobs)" -> "PostgreSQL (StatefulSet)" [label="", color="purple", style="solid", label=<Worker to PostgreSQL<BR/>Protocol: PostgreSQL/TLS>, id="edge_Worker_Pod__async_jobs__PostgreSQL__StatefulSet_", fontsize=7, class="protocol-PostgreSQL_TLS"];
  
  "Backend API Pod (Node.js)" -> "Vault (Platform)" [label="", color="darkgreen", style="solid", label=<Backend API to Vault<BR/>Protocol: HTTPS>, id="edge_Backend_API_Pod__Node_js__Vault__Platform_", fontsize=7, class="protocol-HTTPS"];
  
  "Worker Pod (async jobs)" -> "Vault (Platform)" [label="", color="darkgreen", style="solid", label=<Worker to Vault<BR/>Protocol: HTTPS>, id="edge_Worker_Pod__async_jobs__Vault__Platform_", fontsize=7, class="protocol-HTTPS"];
  
  "Prometheus + Alertmanager" -> "Backend API Pod (Node.js)" [label="", color="red", style="solid", label=<Prometheus Scrape<BR/>Protocol: HTTP>, id="edge_Prometheus___Alertmanager_Backend_API_Pod__Node_js_", fontsize=7, class="protocol-HTTP"];
  
  "Grafana" -> "Prometheus + Alertmanager" [label="", color="red", style="solid", label=<Grafana to Prometheus<BR/>Protocol: HTTP>, id="edge_Grafana_Prometheus___Alertmanager", fontsize=7, class="protocol-HTTP"];
  
  "Developer" -> "kube-apiserver" [label="", color="darkgreen", style="solid", label=<Developer kubectl<BR/>Protocol: HTTPS/mTLS>, id="edge_Developer_kube_apiserver", fontsize=7, class="protocol-HTTPS_mTLS"];
  
  "CI/CD Pipeline" -> "kube-apiserver" [label="", color="darkgreen", style="solid", label=<CI/CD Helm Deploy<BR/>Protocol: HTTPS/mTLS>, id="edge_CI_CD_Pipeline_kube_apiserver", fontsize=7, class="protocol-HTTPS_mTLS"];
  
  "CI/CD Pipeline" -> "Container Registry (Harbor)" [label="", color="darkgreen", style="solid", label=<CI/CD Image Push<BR/>Protocol: HTTPS>, id="edge_CI_CD_Pipeline_Container_Registry__Harbor_", fontsize=7, class="protocol-HTTPS"];
  
  "Ingress Controller (Nginx)" -> "kube-apiserver" [label="", color="darkgreen", style="solid", label=<Ingress Controller to kube-apiserver<BR/>Protocol: HTTPS/mTLS>, id="edge_Ingress_Controller__Nginx__kube_apiserver", fontsize=7, class="protocol-HTTPS_mTLS"];
  
  "Cert-Manager" -> "kube-apiserver" [label="", color="darkgreen", style="solid", label=<Cert-Manager to kube-apiserver<BR/>Protocol: HTTPS/mTLS>, id="edge_Cert_Manager_kube_apiserver", fontsize=7, class="protocol-HTTPS_mTLS"];
  
  "etcd" -> "kube-apiserver" [dir="both", label="
↔️ Bidirectional", color="teal", style="solid", label=<etcd to kube-apiserver<BR/>Protocol: gRPC/mTLS>, id="edge_etcd_kube_apiserver", fontsize=7, class="protocol-gRPC_mTLS"];
  
  "Attacker" -> "Ingress Controller (Nginx)" [label="", color="darkgreen", style="solid", label=<Attacker via exposed API<BR/>Protocol: HTTPS>, id="edge_Attacker_Ingress_Controller__Nginx_", fontsize=7, class="protocol-HTTPS"];
  
  "Attacker" -> "kube-apiserver" [label="", color="red", style="solid", label=<Attacker SSRF to metadata<BR/>Protocol: HTTP>, id="edge_Attacker_kube_apiserver", fontsize=7, class="protocol-HTTP"];
  

  
}